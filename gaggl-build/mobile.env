# Build settings for the personal FOSS build. No secrets in here.

# Installs as its own app, beside the official Podverse Next if that's ever installed too
PODVERSE_ANDROID_PACKAGE=com.podverse.gaggl
PODVERSE_APP_NAME="Podverse (gaggl)"

# Public next-gen alpha
EXPO_PUBLIC_MOBILE_API_BASE_URL=https://api.alpha.podverse.fm/api/v2
EXPO_PUBLIC_MOBILE_WEB_BASE_URL=https://alpha.podverse.fm

# FOSS flavour: no Firebase push, no Play Billing.
# UnifiedPush in the app is still a stub (a fixed endpoint set at build time), so push is off for now.
EXPO_PUBLIC_MOBILE_PUSH_PROVIDER=none
EXPO_PUBLIC_MOBILE_BILLING=unavailable

# Own deep-link scheme, so links don't collide with the official app's podverse-next://
EXPO_PUBLIC_MOBILE_DEEP_LINK_SCHEMES=podverse-gaggl

# Show the Value4Value (boost) UI
EXPO_PUBLIC_MOBILE_V4V_ENABLED=1

EXPO_PUBLIC_ACCOUNT_SIGNUP_MODE=user_signup_email
